# Copier en .env, puis : set -a && source .env && set +a
# 0 : gabarits seuls (aucun modèle requis) ; 1 : petit LLM pour formuler les conseils.
ASSISTANT_LLM=0
# 1 : en plus, escalade vers le gros modèle quand un message reste incompris (déconseillé).
ASSISTANT_ESCALADE=0

# Serveur par rôle : ollama (poste de la salle) ou vllm (DeepEirb, API compatible OpenAI).
LLM_API=ollama
# LLM_API_FORMULATION=ollama
# LLM_API_ESCALADE=vllm

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ministral-3:3b
OLLAMA_MODEL_ESCALADE=ministral-3:14b

# Adresse et clé communiquées par Denis Barthou, si on utilise DeepEirb.
# VLLM_BASE_URL=http://deepeirb:8000/v1
# VLLM_API_KEY=

# Journal des messages incompris (défaut : eval/incompris.jsonl).
# INCOMPRIS_FICHIER=eval/incompris.jsonl
# Nom du poste dans le tableau du banc de formulation (défaut : nom réseau, CPU ou GPU).
# BANC_MACHINE=RTX 3070
